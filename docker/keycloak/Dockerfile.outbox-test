FROM maven:3.9.11-eclipse-temurin-21@sha256:6fdc855a6ed81d288ca7ca37ac6ff5e9308b612485c0801d70b25a858c83d237 AS provider
WORKDIR /build
COPY provider/pom.xml ./pom.xml
COPY provider/src ./src
RUN mvn -B -ntp package

FROM quay.io/keycloak/keycloak:26.8.1@sha256:a78d6b79572168cb25886b80a8b5b8d4ed4390743e3eecb810538683e209dd6b
ENV KC_DB=postgres KC_HEALTH_ENABLED=true KC_METRICS_ENABLED=true
COPY --from=provider --chown=keycloak:keycloak /build/target/identity-outbox-0.1.0.jar /opt/keycloak/providers/identity-outbox.jar
RUN /opt/keycloak/bin/kc.sh build
